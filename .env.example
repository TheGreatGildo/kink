# Environment variables for Foundry scripts
# Copy to .env and replace the placeholder values before running any scripts.

# Required for broadcasting transactions
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
OPTIMISM_RPC_URL=https://optimism-mainnet.infura.io/v3/YOUR_KEY

# Set after deploying the factory (needed by helper scripts)
FACTORY_ADDRESS=0xYourFactoryAddress

# Optional: used by DeployAndSetup.sh to populate the frontend config
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
